# Скопировать в .env и поправить под себя
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL="postgresql://p2pguard:p2pguard@localhost:5435/p2pguard?schema=public"

# Секрет для подписи JWT. В проде — длинная случайная строка (openssl rand -hex 32)
JWT_SECRET="dev-secret-change-me-please-32-chars-min"

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Через запятую. chrome-extension://<id> добавляется после первой сборки расширения.
CORS_ORIGINS="http://localhost:5174,http://127.0.0.1:5174"
# Разрешить любые chrome-extension://* источники (удобно в dev, в проде — false)
ALLOW_ANY_EXTENSION_ORIGIN=true

# Первичный админ, создаётся командой `npm run seed`
SEED_ADMIN_UID="100000001"
SEED_ADMIN_PASSWORD="admin12345"
